{
  "name": "ai-dev-workflow",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "The AI-assisted development workflow I run on production work: agent rules, skills, hooks, quality gates and CI.",
  "author": "Igor Sergienko (https://github.com/SpaceHolderdJs)",
  "license": "MIT",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "lefthook install || exit 0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run && stryker run stryker.boundary.json",
    "test:mutation:boundary": "stryker run stryker.boundary.json"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
