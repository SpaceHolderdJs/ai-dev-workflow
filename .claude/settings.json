{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run check:types)",
      "Bash(npm run check:deps)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npx vitest run:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git switch -c:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx supabase:*)",
      "Edit(.github/**)",
      "Edit(lefthook.yml)",
      "Edit(eslint.config.mjs)",
      "Edit(knip.config.ts)",
      "Edit(tsconfig.json)",
      "Edit(AGENTS.md)"
    ],
    "deny": [
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-bash.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/lint-touched-file.mjs" }
        ]
      }
    ]
  }
}
